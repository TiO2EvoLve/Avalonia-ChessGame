<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Chess.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1600" d:DesignHeight="800"
        Width="1600" Height="800"
        x:Class="Chess.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="Chess">

    <Design.DataContext>
        <vm:MainWindowViewModel/>
    </Design.DataContext>

    <Window.Resources>
        <vm:HighlightConverter x:Key="HighlightConverter" />
        <vm:PieceToImageConverter x:Key="PieceToImageConverter" />
    </Window.Resources>

    <Grid ColumnDefinitions="*,*">
        <ItemsControl ItemsSource="{Binding BoardSquares}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <UniformGrid Rows="8" Columns="8"/>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:SquareViewModel">
                    <Border BorderBrush="Transparent" BorderThickness="1">
                        <Border.Background>
                            <MultiBinding Converter="{StaticResource HighlightConverter}">
                                <Binding Path="IsHighlighted"/>
                                <Binding Path="Background"/>
                            </MultiBinding>
                        </Border.Background>
                        <Button Command="{Binding SelectCommand}" CommandParameter="{Binding}" 
                                HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                Background="Transparent" BorderThickness="0">
                            <Image Source="{Binding PieceSymbol, Converter={StaticResource PieceToImageConverter}}"
                                    Stretch="Uniform"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Button>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </Grid>

</Window>
